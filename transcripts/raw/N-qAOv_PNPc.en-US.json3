  }, {
    "tStartMs": 4174620,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And you don't have to be an expert. Partly\nwhat I want to show with this podcast is"
    } ]
  }, {
    "tStartMs": 4178280,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "how we're all figuring it out together,"
    } ]
  }, {
    "tStartMs": 4181000,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "right?"
