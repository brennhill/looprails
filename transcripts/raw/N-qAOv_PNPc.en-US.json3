    "tStartMs": 3103420,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And it was because I didn't know that—this\nis going to get really technical for just"
    } ]
  }, {
    "tStartMs": 3107140,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "a second—I didn't know that, like, JSON\npath errors in a step function are not"
    } ]
  }, {
    "tStartMs": 3112700,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "catchable and they're not retryable."
