  }, {
    "tStartMs": 3188420,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "And between Wednesday and Friday, I\nre-architected all of the error handling"
    } ]
  }, {
    "tStartMs": 3193480,
