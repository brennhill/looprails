  }, {
    "tStartMs": 4108240,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "even though I know it, I forget it often."
    } ]
  }, {
    "tStartMs": 4110540,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "I'm like, I literally am having more fun\nthan I think I've had in my entire career,"
    } ]
  }, {
    "tStartMs": 4114700,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "and I'm obsessed right now, and I code all\nday long."
