    "segs": [ {
      "utf8": "iterate from there? Because, like,\nyesterday I gave this exact same talk, and"
    } ]
  }, {
    "tStartMs": 2912620,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "someone was like, okay, if we were where\nyou were four months ago, how should we"
