    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "interleaved in this way. I find that it\nreally can really help language models,"
    } ]
  }, {
    "tStartMs": 2341680,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "especially since you're updating it with\nyour understanding and knowledge."
