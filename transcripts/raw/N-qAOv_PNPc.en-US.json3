    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "sharing with each other. It just, it feels\nreally similar and really fun."
    } ]
  }, {
    "tStartMs": 4146660,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Yeah, the amount you're having fun is\ndefinitely coming through the screen."
    } ]
  }, {
    "tStartMs": 4149860,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "I can definitely feel it all the way over\nhere."
