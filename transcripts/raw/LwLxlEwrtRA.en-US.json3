  }, {
    "tStartMs": 2564600,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "type of thing."
    } ]
  }, {
    "tStartMs": 2566300,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "All right, so we're back to this slide\nagain, and we have our bases covered."
    } ]
  }, {
    "tStartMs": 2570860,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Verifiable evals was Harness Code with\ncode completion."
